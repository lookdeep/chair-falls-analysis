/outputs/manifests/*
/outputs/qa/*
/paper/reconcile/*
/paper/seed_media/*

# Keep directory placeholders
!/data/raw/.gitkeep
!/data/staged/.gitkeep
!/outputs/audit/.gitkeep
!/outputs/manifests/.gitkeep
!/outputs/qa/.gitkeep
!/paper/reconcile/.gitkeep
